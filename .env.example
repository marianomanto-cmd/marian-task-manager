# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin email (Mariano). Only this email can edit the Projects board.
# If unset, no one is treated as admin (fail closed).
ADMIN_EMAIL=

# Anthropic API key — used by the Briefs tab to read PDFs with Claude.
ANTHROPIC_API_KEY=
# Optional: model used to read briefs (default: claude-haiku-4-5).
BRIEFS_MODEL=
