# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, used by seed scripts in later phases

# Anthropic (added in Fase 3)
ANTHROPIC_API_KEY=

# Admin email (Mariano). The user whose Bandeja + Calendario tabs are
# visible; the rest of the team only sees Tareas + Agenda + Proyectos.
# If unset, no one is treated as admin (fail closed).
ADMIN_EMAIL=

# Google OAuth (configured inside Supabase Auth → Providers → Google;
# only needed locally if you wire Google APIs directly outside Supabase)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Slack notifications: post to a single channel via an Incoming Webhook.
# Leave empty in dev to silence notifications. Create at:
# https://api.slack.com/apps → your app → Incoming Webhooks → Add to workspace
SLACK_WEBHOOK_URL=

# Base URL the app is served from (used in Slack links back to the task).
# Example: https://marian-task-manager.vercel.app
APP_BASE_URL=
